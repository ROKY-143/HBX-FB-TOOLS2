import os
import sys
import shutil
import platform

# ৩২-বিট (32-bit) চেক করার জন্য
arch = platform.machine().lower()
if 'armv7' in arch or 'armv8l' in arch or 'i386' in arch or 'i686' in arch:
    print("\n[!] 32-bit Device Detected!")
    print("[!] This tool only supports 64-bit (AArch64) devices.\n")
    sys.exit(1)

cur_dir = os.path.dirname(os.path.abspath(__file__))
target_so = None

# HBXFBB দিয়ে শুরু এবং .so দিয়ে শেষ ফাইল খোঁজা
for f in os.listdir(cur_dir):
    if f.startswith("HBXFBB") and f.endswith(".so"):
        target_so = os.path.join(cur_dir, f)
        break

if target_so is None:
    print("[!] ERROR: HBXFBB.so file not found!")
    print("[!] Please make sure the .so file matching your Python version is present.")
    sys.exit(1)

# টার্মাক্স স্টোরেজ পারমিশন ও ক্যাশে ডিরেক্টরিতে কপি করা
try:
    if "/storage/emulated/" in cur_dir or "/sdcard" in cur_dir:
        cache_dir = os.path.expanduser("~/.cache_hbx_runner")
        os.makedirs(cache_dir, exist_ok=True)
        cache_so = os.path.join(cache_dir, "HBXFBB.so")
        shutil.copy2(target_so, cache_so)
        if cache_dir not in sys.path:
            sys.path.insert(0, cache_dir)
    else:
        if cur_dir not in sys.path:
            sys.path.insert(0, cur_dir)

    # এখন সঠিক নাম HBXFBB ইমপোর্ট করা হচ্ছে
    import HBXFBB

except ImportError as e:
    print(f"\n[!] ERROR: Python Version Mismatch or Missing Library!")
    print(f"[!] Details: {e}")
    print("[!] Tip: Make sure your HBXFBB.so file matches your current Python version (e.g., Python 3.14).\n")
    sys.exit(1)

# মেইন ফাংশন রান করা
if hasattr(HBXFBB, "main"):
    HBXFBB.main()
elif hasattr(HBXFBB, "run"):
    HBXFBB.run()
else:
    print("[!] ERROR: No main() or run() function found in HBXFBB module!")
    sys.exit(1)
